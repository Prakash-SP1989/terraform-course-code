resource "azurerm_network_interface" "web_vm_nic" {
  name                = "${local.resource_name_prefix}-nic"
  location            = azurerm_resource_group.my-rg.location #it get from the state file
  resource_group_name = azurerm_resource_group.my-rg.name

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.web-subnet.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.web-vm-pip.id
  }
}
